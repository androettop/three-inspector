{
  "manifest_version": 3,
  "name": "Three Inspector",
  "version": "0.1.0",
  "description": "Find three.js scenes on any page, even when three.js is bundled and hidden, and export their models to STL or 3MF.",
  "action": {
    "default_title": "Inspect three.js scenes on this page",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
